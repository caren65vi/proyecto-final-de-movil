rules_version = '2';

// Reglas del proyecto assistudla.
// Roles: docente y estudiante; cada usuario elige su rol al registrarse.
// Lo que hace el servidor (Cloud Functions) no pasa por estas reglas:
// crear sesiones, el QR, registrar asistencia por QR, contadores y avisos.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------

    function autenticado() {
      return request.auth != null;
    }

    // Rol del usuario que hace la petición, leído de su documento
    function rolActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esDocente() {
      return autenticado() && rolActual() == 'docente';
    }

    // Correo de la sesión; solo cuenta si ya lo verificó
    function miCorreo() {
      return request.auth.token.email_verified == true
          ? request.auth.token.email.lower()
          : '';
    }

    function grupo(grupoId) {
      return get(/databases/$(database)/documents/grupos/$(grupoId)).data;
    }

    // El docente que hace la petición es el dueño del grupo
    function esDueno(grupoId) {
      return autenticado() && grupo(grupoId).docenteUid == request.auth.uid;
    }

    // El estudiante que hace la petición está inscrito en el grupo
    function estaInscrito(grupoId) {
      return autenticado() && miCorreo() != '' && exists(
        /databases/$(database)/documents/grupos/$(grupoId)/inscripciones/$(miCorreo())
      );
    }

    // Solo cambian los campos de la lista
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- usuarios ----------

    match /usuarios/{uid} {

      // Registro: cada usuario crea solo su documento, con un rol válido
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.rol in ['docente', 'estudiante'];

      // Cada usuario lee su documento; el docente lee todos
      allow read: if autenticado()
                  && (request.auth.uid == uid || rolActual() == 'docente');

      // Cada usuario edita su nombre y su código, nunca su rol;
      // el docente edita o elimina, y solo a estudiantes
      allow update: if (autenticado()
                        && request.auth.uid == uid
                        && soloCambia(['nombre', 'codigoEstudiante']))
                    || (esDocente() && resource.data.rol == 'estudiante');

      allow delete: if esDocente() && resource.data.rol == 'estudiante';
    }

    // ---------- sedes y periodos (solo lectura; se editan en la consola) ----------

    match /sedes/{sedeId} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /periodos/{periodoId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ---------- grupos ----------

    match /grupos/{grupoId} {

      // El dueño lo ve (también en la consulta where docenteUid == miUid);
      // el estudiante lo ve si está inscrito (lectura por ID)
      allow read: if autenticado()
                  && (resource.data.docenteUid == request.auth.uid
                      || estaInscrito(grupoId));

      // Un docente crea grupos a su nombre, con los contadores en cero
      allow create: if esDocente()
                    && request.resource.data.docenteUid == request.auth.uid
                    && request.resource.data.horasTotales is number
                    && request.resource.data.horasTotales > 0
                    && request.resource.data.metaAsistencia is number
                    && request.resource.data.metaAsistencia > 0
                    && request.resource.data.metaAsistencia <= 1
                    && request.resource.data.horario is list
                    && request.resource.data.ubicacion is latlng
                    && request.resource.data.radioMetros is number
                    && request.resource.data.sesionesCerradas == 0
                    && request.resource.data.totalPresentes == 0
                    && request.resource.data.totalAusentes == 0
                    && request.resource.data.totalJustificadas == 0;

      // El dueño edita los datos del curso; los contadores los lleva el servidor
      allow update: if esDueno(grupoId)
                    && soloCambia([
                         'nombreMateria', 'facultad', 'numeroGrupo', 'aula',
                         'docenteNombre', 'periodoId', 'fechaInicio', 'fechaFin',
                         'horasTotales', 'metaAsistencia', 'horario',
                         'ubicacion', 'radioMetros'
                       ]);

      allow delete: if esDueno(grupoId);

      // ----- inscripciones: la lista de clase -----

      match /inscripciones/{correo} {

        allow read: if esDueno(grupoId) || correo == miCorreo();

        // El docente agrega estudiantes por correo, con horas en cero
        allow create: if esDueno(grupoId)
                      && request.resource.data.correo == correo
                      && correo == correo.lower()
                      && request.resource.data.horasAsistidas == 0
                      && request.resource.data.horasFalta == 0
                      && request.resource.data.horasJustificadas == 0;

        // El docente corrige nombre o código; el estudiante enlaza su cuenta
        allow update: if (esDueno(grupoId)
                          && soloCambia(['nombre', 'codigoEstudiante']))
                      || (correo == miCorreo()
                          && soloCambia(['uid', 'codigoEstudiante'])
                          && request.resource.data.uid == request.auth.uid);

        allow delete: if esDueno(grupoId);
      }

      // ----- sesiones: las crea y cierra el servidor -----

      match /sesiones/{sesionId} {

        allow read: if esDueno(grupoId) || estaInscrito(grupoId);
        allow write: if false;

        // Token del QR: solo lo ve el docente para mostrarlo
        match /privado/{documento} {
          allow read: if esDueno(grupoId);
          allow write: if false;
        }

        // ----- asistencias -----

        match /asistencias/{correo} {

          allow read: if esDueno(grupoId) || correo == miCorreo();

          // Asistencia manual (estudiante que no pudo escanear)
          allow create: if esDueno(grupoId)
                        && request.resource.data.metodo == 'manual'
                        && request.resource.data.estado in ['presente', 'ausente', 'justificada']
                        && request.resource.data.modificadaPor == request.auth.uid;

          // Corrección o justificación del docente
          allow update: if esDueno(grupoId)
                        && soloCambia([
                             'estado', 'horas', 'justificacion',
                             'modificadaPor', 'modificadaEn'
                           ])
                        && request.resource.data.estado in ['presente', 'ausente', 'justificada']
                        && request.resource.data.modificadaPor == request.auth.uid
                        && request.resource.data.modificadaEn == request.time;

          allow delete: if false;
        }
      }
    }

    // ---------- "mis materias" del estudiante ----------
    // Consulta collectionGroup('inscripciones').where('correo', isEqualTo: miCorreo)

    match /{ruta=**}/inscripciones/{correo} {
      allow read: if autenticado() && resource.data.correo == miCorreo();
    }

    // ---------- notificaciones ----------

    match /notificaciones/{id} {
      // Consulta where('correo', isEqualTo: miCorreo)
      allow read: if autenticado() && resource.data.correo == miCorreo();

      // Solo marcarla como leída o borrarla; las crea el servidor
      allow update: if autenticado()
                    && resource.data.correo == miCorreo()
                    && soloCambia(['leida']);
      allow delete: if autenticado() && resource.data.correo == miCorreo();
      allow create: if false;
    }
  }
}
